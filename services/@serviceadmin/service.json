{
  "id": "@serviceadmin",
  "name": "Core Service Admin",
  "description": "Core operator/admin UI service backed by the canonical lasso-serviceadmin release artifact.",
  "version": "0.1.0",
  "enabled": true,
  "depend_on": [
    "@node"
  ],
  "artifact": {
    "kind": "archive",
    "source": {
      "type": "github-release",
      "repo": "service-lasso/lasso-serviceadmin",
      "tag": "2026.4.18-170a1af"
    },
    "platforms": {
      "win32": {
        "assetName": "@serviceadmin-win32.zip",
        "archiveType": "zip",
        "command": "node",
        "args": [
          "runtime/server.js"
        ]
      },
      "linux": {
        "assetName": "@serviceadmin-linux.tar.gz",
        "archiveType": "tar.gz",
        "command": "node",
        "args": [
          "runtime/server.js"
        ]
      },
      "darwin": {
        "assetName": "@serviceadmin-darwin.tar.gz",
        "archiveType": "tar.gz",
        "command": "node",
        "args": [
          "runtime/server.js"
        ]
      }
    }
  },
  "healthchecks": [
    {
      "id": "serviceadmin-process-health",
      "type": "process"
    }
  ],
  "endpoints": [
    {
      "id": "ui",
      "kind": "network",
      "label": "Service Admin UI",
      "direction": "inbound",
      "transport": "tcp",
      "protocol": "http",
      "bind": "127.0.0.1",
      "port": {
        "default": 17700,
        "strategy": "preferred"
      },
      "exposure": "local",
      "required": true,
      "primary": true
    },
    {
      "id": "ui_url",
      "kind": "url",
      "label": "UI",
      "target": "ui",
      "url": "http://${endpoint.ui.bind}:${endpoint.ui.port}/",
      "exposure": "local",
      "required": true,
      "primary": true
    }
  ]
}
